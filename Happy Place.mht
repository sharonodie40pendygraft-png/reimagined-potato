}

.animate-twinkle { animation: 3.2s ease-in-out 0s infinite normal none running twinkle; }

.animate-float-slow { animation: 7s ease-in-out 0s infinite normal none running float-slow; }

.animate-door-glow { animation: 4s ease-in-out 0s infinite normal none running door-glow; }

.animate-drift { animation: 14s ease-in-out 0s infinite normal none running drift; }

.animate-flutter { transform-origin: 50% center; animation: 0.35s ease-in-out 0s infinite normal none running flutter; }

.animate-pulse-ring { animation: 2.4s ease-out 0s infinite normal none running pulse-ring; }

.animate-rise-in { animation: 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise-in; }

.animate-petal { animation: auto linear 0s infinite normal none running petal-fall; }

