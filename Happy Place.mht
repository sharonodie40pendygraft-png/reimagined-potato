.magic-button::after { content: ""; z-index: -1; background: linear-gradient(90deg, rgba(0, 0, 0, 0), oklch(1 0 0 / 0.35), rgba(0, 0, 0, 0)); width: 40%; animation: 3s ease-in-out 0s infinite normal none running shimmer; position: absolute; inset: 0px auto 0px 0px; }

.magic-button:hover { transform: translateY(-2px) scale(1.02); box-shadow: oklch(0.93 0.05 85 / 0.6) 0px 0px 0px 1px, oklch(0.7 0.2 305 / 0.8) 0px 0px 40px, oklch(0.7 0.2 305 / 0.4) 0px 0px 120px; }

